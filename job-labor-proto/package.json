{
  "name": "job-labor-proto",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "proxy": "node proxy-server.js",
    "mock-api": "node mock-api-server.js",
    "test": "jest",
    "test:unit": "jest --testPathPattern='__tests__/(services|utils)'",
    "test:integration": "jest --testPathPattern='__tests__/(auth.integration|e2e)'",
    "test:e2e": "node --max-old-space-size=4096 --expose-gc node_modules/.bin/jest --testPathPattern='__tests__/e2e' --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageReporters=text --coverageReporters=text-summary",
    "test:ci": "jest --ci --coverage --maxWorkers=2"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-community/slider": "5.0.1",
    "@tanstack/react-query": "^5.90.10",
    "expo": "~54.0.25",
    "expo-application": "~7.0.7",
    "expo-auth-session": "~7.0.9",
    "expo-constants": "~18.0.10",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.9",
    "expo-notifications": "~0.29.9",
    "expo-router": "^6.0.15",
    "expo-secure-store": "^15.0.7",
    "expo-status-bar": "~3.0.8",
    "expo-web-browser": "~15.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.18.0",
    "react-native-web": "^0.21.0",
    "ws": "^8.18.3"
  },
  "private": true,
      "jest": {
        "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testTimeout": 20000,
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/?(*.)+(spec|test).js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/testUtils.js",
      "/__tests__/mockHelpers.js"
    ],
    "collectCoverageFrom": [
      "**/*.js",
      "!**/__tests__/**",
      "!**/node_modules/**",
      "!**/coverage/**",
      "!**/*.test.js",
      "!**/*.spec.js",
      "!**/jest.setup.js",
      "!**/index.js"
    ],
    "coverageReporters": [
      "text",
      "text-summary",
      "lcov",
      "html"
    ],
    "verbose": false,
    "coverageThreshold": {
      "global": {
        "statements": 0,
        "branches": 0,
        "functions": 0,
        "lines": 0
      }
    }
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.1.10",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "http-proxy-middleware": "^2.0.9",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.13",
    "msw": "^1.3.2",
    "multer": "^2.0.2",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2",
    "whatwg-fetch": "^3.6.20",
    "xhr2": "^0.2.1"
  }
}
